# Database
DATABASE_URL="postgresql://user:password@localhost:5432/simplebiz?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Application URLs
# For local development
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_LOCAL_URL="http://localhost:3000"

# For production
NEXT_PUBLIC_PRODUCTION_URL="https://yourdomain.com"

# Resend Email Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxx"

# Email sender address
# For testing, use Resend's default: onboarding@resend.dev
# For production, use your verified domain: noreply@yourdomain.com
NEXT_PUBLIC_NO_REPLY_EMAIL="onboarding@resend.dev"

# Paystack Payment Gateway
# Get your public key from: https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_KEY="pk_test_xxxxxxxxxxxxx"

# Vercel Blob Storage (for file uploads)
# Get from: https://vercel.com/docs/storage/vercel-blob
NEXT_PUBLIC_VERCEL_BLOB_URL="https://your-blob-url.vercel-storage.com"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxx"

# OAuth Providers (Optional)
# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# SimpleBiz Admin Email (for withdrawal notifications)
NEXT_PUBLIC_SIMPLEBIZ_EMAIL="admin@yourdomain.com"
